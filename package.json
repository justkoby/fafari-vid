{
  "name": "fafari-christmas-ad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts",
    "audio": "python3 scripts/make_audio.py",
    "render:story": "remotion render src/index.ts Fafari-9x16 output/fafari-christmas-9x16.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:feed": "remotion render src/index.ts Fafari-4x5 output/fafari-christmas-4x5.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:all": "npm run render:story && npm run render:feed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  }
}